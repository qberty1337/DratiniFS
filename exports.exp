PSP_BEGIN_EXPORTS

# Sony 6.61 fatms syslib: module_start, module_reboot_phase, module_info, module_sdk_version
# (no module_stop: the module is NO_STOP)
PSP_EXPORT_START(syslib, 0, 0x8000)
PSP_EXPORT_FUNC_NID(module_start, 0xD632ACDB)
PSP_EXPORT_FUNC_NID(module_reboot_phase, 0xADF12745)
PSP_EXPORT_VAR_NID(module_info, 0xF01D73A7)
PSP_EXPORT_VAR_NID(module_sdk_version, 0x11B97506)
PSP_EXPORT_END

PSP_END_EXPORTS
